# Copy this file to .env on the server, then change APP_ORIGIN
# to the address you will actually open in the browser.
#
# Tencent Lighthouse usually allows 22 and 80 only.
# Keep the app on host port 80 so you do not need a new firewall rule.

NODE_ENV=production
HOST=0.0.0.0
API_PORT=8787
APP_PORT=80
APP_ORIGIN=http://你的服务器IP
SESSION_COOKIE_SECURE=false
ALLOW_DEV_AUTH=true
HACKATHON_DEMO=true
ADMIN_TOKEN=hackathon-demo-admin
DATABASE_PATH=/app/data/game.db

# Optional. Leave blank if judges should use the demo login.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://你的服务器IP/api/auth/zhihu/callback
ZHIHU_REQUIRE_OAUTH_STATE=true
ZHIHU_ACCESS_SECRET=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
