# Copy this file to .env on the server and replace every placeholder.
DOMAIN=game.example.com
ACME_EMAIL=admin@example.com

# The public HTTPS origin must exactly match the browser URL.
APP_ORIGIN=https://game.example.com
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
SESSION_COOKIE_SECURE=true
ALLOW_DEV_AUTH=false
HACKATHON_DEMO=false
ZHIHU_REQUIRE_OAUTH_STATE=true
DATABASE_PATH=./data/game.db

# Zhihu OAuth and Open Platform credentials.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://game.example.com/api/auth/zhihu/callback
ZHIHU_ACCESS_SECRET=

# OpenAI-compatible model endpoint. The runtime admin panel can override these.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
