# Server
API_PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
ALLOW_DEV_AUTH=true
ADMIN_TOKEN=local-admin
DATABASE_PATH=./data/game.db

# Zhihu OAuth
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/zhihu/callback
ZHIHU_REQUIRE_OAUTH_STATE=true

# Zhihu Open Platform (server-only; never expose in the web UI)
ZHIHU_ACCESS_SECRET=

# DeepSeek OpenAI-compatible API (API key is server-only)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
